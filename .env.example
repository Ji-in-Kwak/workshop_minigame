# Supabase transaction pooler 연결 문자열 (Vercel 배포 시 필수)
# 특수문자는 URL 인코딩 필요. NEXT_PUBLIC_ 접두사 사용 금지.
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# 참가자가 접속할 HTTPS 주소 (커스텀 도메인 사용 시 설정, 끝 슬래시 제외)
# NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# 프로덕션 빌드를 로컬 파일 모드로 리허설할 때만 설정 (Vercel에서는 무시됨)
# ALLOW_LOCAL_STORE=true
